# Copy to .env and fill in real values. Never commit the real .env file.

# SQLAlchemy-style connection string for the Postgres database used by the
# API and worker (pipelines, pipeline_versions, runs, jobs tables).
# Defaults match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pipeline_builder

# Redis connection used by the job queue (RQ). Defaults match docker-compose.yml.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
