{
  "schema_version": 1,
  "pipeline_id": "sales-example",
  "nodes": [
    {
      "id": "source",
      "type": "source.csv",
      "config": {
        "path": "/Users/ben/Planning/example_data/sales.csv"
      }
    },
    {
      "id": "select",
      "type": "transform.select",
      "config": {
        "columns": ["region", "product", "quantity", "price"]
      }
    },
    {
      "id": "filter",
      "type": "transform.filter",
      "config": {
        "expression": {
          "type": "binary_operation",
          "operator": ">",
          "left": { "type": "column", "name": "quantity" },
          "right": { "type": "literal", "value": 1 }
        }
      }
    },
    {
      "id": "calculate",
      "type": "transform.expression",
      "config": {
        "columns": [
          {
            "alias": "revenue",
            "expression": {
              "type": "binary_operation",
              "operator": "*",
              "left": { "type": "column", "name": "quantity" },
              "right": { "type": "column", "name": "price" }
            }
          }
        ]
      }
    },
    {
      "id": "aggregate",
      "type": "transform.aggregate",
      "config": {
        "group_by": ["region"],
        "aggregations": [
          { "column": "revenue", "function": "sum", "alias": "revenue" }
        ]
      }
    },
    {
      "id": "sink",
      "type": "sink.parquet",
      "config": {
        "path": "/Users/ben/Planning/example_data/output/sales_output.parquet"
      }
    }
  ],
  "edges": [
    {
      "source": "source",
      "target": "select"
    },
    {
      "source": "select",
      "target": "filter"
    },
    {
      "source": "filter",
      "target": "calculate"
    },
    {
      "source": "calculate",
      "target": "aggregate"
    },
    {
      "source": "aggregate",
      "target": "sink"
    }
  ]
}
